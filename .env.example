# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=
# Mistral API key (console.mistral.ai → API Keys)
MISTRAL_API_KEY=

# --- Optional settings ---------------------------------------------------------------------------
# Every one of these is also a setting in the admin dashboard. The value here is the default; a
# value saved in the dashboard wins until you reset it there. Leave a line out for the built-in
# default shown.

# Models
MISTRAL_MODEL=mistral-large-4
# Reasoning effort for normal replies: none, low, medium or high (research uses the default)
REASONING_EFFORT=low
# Faster model for the hosted web search and image generation
TOOL_MODEL=mistral-medium-latest
TRANSCRIBE_MODEL=voxtral-mini-transcribe-3
OCR_MODEL=mistral-ocr-latest

# Behaviour
# How many recent channel messages the bot reads with a new question (0 to 50)
CONTEXT_MESSAGES=10
# How many frames of a video the model sees (1 to 20)
VIDEO_FRAMES=6
# Custom server emote the bot reacts with while it thinks (falls back to 🤔)
THINKING_EMOTE=hmmmm
TIMEZONE=Europe/Ljubljana
# A reply after this many hours starts a new conversation
SESSION_IDLE_HOURS=6

# Limits
MAX_RESEARCH_JOBS=3
RESEARCH_TIMEOUT_MINUTES=20
MAX_MEMORIES=100
# Scheduled tasks per server, and per person
MAX_TASKS=25
MAX_TASKS_PER_PERSON=10

# Style learning
LEARN_EVERY_HOURS=24
# How far back a run reads at most
STYLE_WINDOW_DAYS=7
# A run with fewer new messages is skipped
STYLE_MIN_MESSAGES=20

# --- Infrastructure (only here, not in the dashboard) --------------------------------------------
DB_PATH=data/debeloglav.db
# Admin dashboard: the bot serves a password-protected web UI (leave the password empty to disable it)
DASHBOARD_PASSWORD=
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8080
# Comma-separated IPs of reverse proxies in front of the dashboard (e.g. Caddy on the same host,
# or with Docker Compose the Docker bridge gateway such as 172.17.0.1, as the container sees it).
# Only from these the X-Forwarded-For header is trusted, so the failed-login lockout can use the
# real client IP. Empty (default) = trust no one and ignore the header.
# DASHBOARD_TRUSTED_PROXIES=
