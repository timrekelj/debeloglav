# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=
# Mistral API key (console.mistral.ai → API Keys)
MISTRAL_API_KEY=
# Admin dashboard password. Every other setting of the bot (models, limits, threads, style
# learning, ...) is changed in the dashboard, not here. Leave it empty to disable the dashboard.
DASHBOARD_PASSWORD=

# --- Deployment (optional) -----------------------------------------------------------------------
# These are needed before the database opens, so they can't be dashboard settings.
# DB_PATH=data/debeloglav.db
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8080
# Comma-separated IPs of reverse proxies in front of the dashboard (e.g. Caddy on the same host,
# or with Docker Compose the Docker bridge gateway such as 172.17.0.1, as the container sees it).
# Only from these the X-Forwarded-For header is trusted, so the failed-login lockout can use the
# real client IP. Empty (default) = trust no one and ignore the header.
# DASHBOARD_TRUSTED_PROXIES=
