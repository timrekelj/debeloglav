# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=
# Mistral API key (console.mistral.ai → API Keys)
MISTRAL_API_KEY=
# Optional
MISTRAL_MODEL=mistral-large-4
CONTEXT_MESSAGES=10
TRANSCRIBE_MODEL=voxtral-mini-transcribe-3
VIDEO_FRAMES=6
OCR_MODEL=mistral-ocr-latest
TIMEZONE=Europe/Ljubljana
DB_PATH=data/debeloglav.db
MAX_RESEARCH_JOBS=3
# Faster model for the hosted web search and image generation
TOOL_MODEL=mistral-medium-latest
# Reasoning effort for normal replies: low, medium or high (research uses the default)
REASONING_EFFORT=low
# Custom server emote the bot reacts with while it thinks (falls back to 🤔)
THINKING_EMOTE=hmmmm
# Admin dashboard: the bot serves a password-protected web UI (leave the password empty to disable it)
DASHBOARD_PASSWORD=
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8080
# Comma-separated IPs of reverse proxies in front of the dashboard (e.g. Caddy on the same host,
# or with Docker Compose the Docker bridge gateway such as 172.17.0.1, as the container sees it).
# Only from these the X-Forwarded-For header is trusted, so the failed-login lockout can use the
# real client IP. Empty (default) = trust no one and ignore the header.
# DASHBOARD_TRUSTED_PROXIES=
